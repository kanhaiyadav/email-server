PORT=3001

# Resend API key — get it from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender address from your Resend dashboard
# During testing you can use: onboarding@resend.dev (only sends to your own email)
# For production: use an address from your verified domain e.g. noreply@kanhaiya.me
RESEND_FROM_EMAIL=Portfolio Contact <noreply@kanhaiya.me>

# Recipient — where contact form emails land
EMAIL_TO=kanhaiyadav.me@gmail.com

# Allowed origin (your deployed portfolio URL or localhost for dev)
ALLOWED_ORIGIN=http://localhost:5173
